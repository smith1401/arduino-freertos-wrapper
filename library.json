{
    "name": "Arduino FreeRTOS Wrapper",
    "version": "2.0.1",
    "keywords": "rtos, freertos, timing, thread, task, queue, mutex, semaphore, timer, arduino, pub, sub",
    "description": "C++ wrapper for FreeRTOS on Arduino (ESP32, STM32, nRF52): tasks, queues, mutexes, semaphores, timers, event groups, message buffers, typed publish/subscribe and a thread safe logger",
    "authors": {
        "name": "smith1401",
        "maintainer": true
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/smith1401/arduino-freertos-wrapper"
    },
    "license": "MIT",
    "frameworks": "arduino",
    "platforms": [
        "ststm32",
        "espressif32",
        "nordicnrf52"
    ],
    "build": {
        "libLDFMode": "deep+",
        "libCompatMode": "strict"
    },
    "dependencies": [
        {
            "name": "CircularBuffer",
            "version": "https://github.com/rlogiacco/CircularBuffer.git",
            "platforms": [
                "ststm32",
                "espressif32",
                "nordicnrf52"
            ]
        }
    ],
    "export": {
        "exclude": [
            "test",
            ".github"
        ]
    },
    "examples": [
        "examples/*/*.ino"
    ]
}
